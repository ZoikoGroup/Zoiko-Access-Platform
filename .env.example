# Copy to .env and edit. NEVER commit .env. These are DEV-ONLY placeholder values.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- Cell identity (one deployment = one cell; same code runs in every cell) ---
ZOIKO_CELL_ID=DEV-01

# --- PostgreSQL (one database per cell) ---
POSTGRES_DB=zoiko_dev01
POSTGRES_USER=zoiko
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Field-level encryption of health data (foundation/crypto.py) ---
# One or more "id:base64" keys of 32 random bytes. Make one with:
#   python -c "import base64,secrets;print('k1:'+base64.b64encode(secrets.token_bytes(32)).decode())"
# Production: keep this in a managed secret store (decision DEV-016), never in git.
ZOIKO_FIELD_KEYS=k1:REPLACE-with-base64-of-32-random-bytes
ZOIKO_FIELD_KEY_ID=k1
# Where the keys come from (DEV-396): "env" on a developer's computer; on a real server "aws_kms",
# and then each entry above is the key ENCRYPTED by AWS KMS ("k1:<base64 CiphertextBlob>", made
# with `aws kms encrypt`). AWS credentials and region come from the server's environment or role:
#   AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY (never in git).
ZOIKO_KEY_SOURCE=env
# Country-pack signing key (Ed25519, base64 of 32 bytes). Leave unset in development (a key is
# derived from DJANGO_SECRET_KEY); a real server refuses to start without it. Make one with:
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# ZOIKO_PACK_SIGNING_KEY=
# Optional: lets a monitoring system read /metrics (request numbers by route). 24+ characters; leave unset to turn it off.
# ZOIKO_METRICS_TOKEN=
# Leave unset. Clinical workflow paths stay off until the local clinical approvals exist.
# ZOIKO_WORKFLOW_CLINICAL=

# --- Providers (DEV-400, decided 27 Nov 2026). Real values only in the server's environment. ---
# Email: MAIL_PROVIDER=ses (AWS SES; uses AWS_REGION and the AWS credentials). Optional:
# SES_CONFIGURATION_SET=zoiko-delivery
# Texts: TEXT_PROVIDER=sns (AWS SNS). Development keeps "console".
# Payments: BILLING_PAYMENT_PROVIDER=stripe with STRIPE_SECRET_KEY=sk_live_REPLACE-me
# Alerts: PAGER_PROVIDER=pagerduty with PAGERDUTY_ROUTING_KEY=REPLACE-me
# AI (DEV-399): AI_PROVIDER=anthropic with ANTHROPIC_API_KEY=REPLACE-me (AI_MODEL=claude-opus-5-5)
# Webhooks (DEV-403): SES delivery events through this SNS topic only, and Stripe's signing secret.
# SES_EVENTS_TOPIC_ARN=arn:aws:sns:eu-west-2:<account>:zoiko-ses-events
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE-me
# First market UK (decided 27 Nov 2026): AWS_REGION=eu-west-2 (London) is the default.
