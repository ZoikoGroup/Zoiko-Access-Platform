# Copy to .env and edit. NEVER commit .env. These are DEV-ONLY placeholder values.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- Cell identity (one deployment = one cell; same code runs in every cell) ---
ZOIKO_CELL_ID=DEV-01

# --- PostgreSQL (one database per cell) ---
POSTGRES_DB=zoiko_dev01
POSTGRES_USER=zoiko
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Field-level encryption of health data (foundation/crypto.py) ---
# One or more "id:base64" keys of 32 random bytes. Make one with:
#   python -c "import base64,secrets;print('k1:'+base64.b64encode(secrets.token_bytes(32)).decode())"
# Production: keep this in a managed secret store (decision DEV-016), never in git.
ZOIKO_FIELD_KEYS=k1:REPLACE-with-base64-of-32-random-bytes
ZOIKO_FIELD_KEY_ID=k1
# Where the keys come from: env (this file, development only), file, or wrapped. See foundation/keys.py.
# ZOIKO_FIELD_KEY_PROVIDER=file
# ZOIKO_FIELD_KEY_FILE=/run/secrets/field-keys.json
# ZOIKO_KEY_WRAP_KEK=
# A server that knowingly keeps its keys in an environment variable says so (the release check allows it).
# ZOIKO_ALLOW_ENV_KEYS=1
# Sign in with an outside provider (OpenID Connect). Google needs only these two:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Others: a JSON list of {"key","name","issuer","client_id","client_secret"}. Redirect addresses must match exactly.
# ZOIKO_SSO_PROVIDERS=
# ZOIKO_SSO_REDIRECT_URIS=http://localhost:5173/,http://localhost:5174/
# The age at which a child comes of age (a parent's access then stops until they decide). Legal fact
# per country: list the countries that differ, and set the default for the rest.
# ZOIKO_AGE_OF_MAJORITY=GB=18,SG=21
# ZOIKO_AGE_OF_MAJORITY_DEFAULT=18

# --- Country packs (optional; see docs/decisions/REGISTER.md DEV-177, DEV-181) ---
# The country this cell serves, and whether features must be switched on by that country's signed
# pack. Off by default: with it on and no pack installed, booking, messaging and referrals refuse.
# ZOIKO_COUNTRY=GB
# ZOIKO_PACKS_ENFORCED=1
# Public keys that may sign packs, "id:base64,id:base64". Empty means no pack is trusted.
# ZOIKO_PACK_PUBLIC_KEYS=

# Country-pack signing key (Ed25519, base64 of 32 bytes). Leave unset in development (a key is
# derived from DJANGO_SECRET_KEY); a real server refuses to start without it. Make one with:
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# ZOIKO_PACK_SIGNING_KEY=
# Optional: lets a monitoring system read /metrics (request numbers by route). 24+ characters; leave unset to turn it off.
# ZOIKO_METRICS_TOKEN=
# Leave unset. Clinical workflow paths stay off until the local clinical approvals exist.
# ZOIKO_WORKFLOW_CLINICAL=
