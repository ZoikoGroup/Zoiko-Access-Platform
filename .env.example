# Copy to .env and edit. NEVER commit .env. These are DEV-ONLY placeholder values.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- Cell identity (one deployment = one cell; same code runs in every cell) ---
ZOIKO_CELL_ID=DEV-01

# --- PostgreSQL (one database per cell) ---
POSTGRES_DB=zoiko_dev01
POSTGRES_USER=zoiko
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
