{
  "key": "J2.referral",
  "version": 1,
  "initial": "sent",
  "states": {
    "sent": {"owner": "clinic"},
    "acknowledged": {"owner": "clinic"},
    "needs_info": {"owner": "referrer"},
    "accepted": {"owner": "clinic"},
    "declined": {"owner": "clinic"}
  },
  "terminal": {"accepted": "completed", "declined": "cancelled"},
  "transitions": {
