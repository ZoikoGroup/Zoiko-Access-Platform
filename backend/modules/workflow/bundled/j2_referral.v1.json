      "guards": ["human_actor"]
    },
    "accept": {
      "from": ["sent", "acknowledged", "needs_info"], "to": "accepted",
      "guards": ["human_actor"], "requires_evidence": ["professional_acknowledgment"]
    },
    "decline": {
      "from": ["sent", "acknowledged", "needs_info"], "to": "declined",
      "guards": ["human_actor"], "requires_evidence": ["professional_acknowledgment"]
    }
  },
  "timers": {
    "acknowledge_by": {"state": "sent", "after_minutes": 1440},
    "decide_by": {"state": "acknowledged", "after_minutes": 4320},
    "info_by": {"state": "needs_info", "after_minutes": 10080}
  }
}
