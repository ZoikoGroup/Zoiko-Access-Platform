# The production image (DEV-196). Runtime dependencies only, gunicorn instead of the development
# server, production settings, and a non-root user. Built clean and run end to end on 2026-11-20
# (backlog A7, DEV-358); backend/.dockerignore keeps local files and caches out of it.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DJANGO_SETTINGS_MODULE=config.settings.production \
    PORT=8000

WORKDIR /app

COPY requirements ./requirements
# pip itself first: the one in the base image had known flaws (DEV-364).
RUN pip install --default-timeout=120 --retries 10 --upgrade "pip>=26.2,<27"
RUN pip install --default-timeout=120 --retries 10 -r requirements/base.txt -r requirements/production.txt

COPY . .

RUN useradd --create-home --uid 10001 zoiko && chown -R zoiko:zoiko /app
USER zoiko

EXPOSE 8000
# Cloud Run sets PORT. Two workers with four threads each is a starting point to measure, not a tuned value.
CMD ["sh", "-c", "exec gunicorn config.wsgi:application --bind 0.0.0.0:${PORT} --workers 2 --threads 4 --timeout 60 --access-logfile -"]
